# nmp-central-ai — local defaults. Copy to .env only if you need to change something.
# Every value here is a LOCAL-ONLY default. AWS values come from Secrets Manager (M2).

# Postgres superuser (the compose stack's own database server)
POSTGRES_USER=nmp
POSTGRES_PASSWORD=nmp
POSTGRES_DB=nmp

# Role + database MLflow uses (created by services/postgres/init/01-mlflow.sh)
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow

# MinIO (S3 API) — local artifact store; in AWS this becomes real S3 + IAM
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MLFLOW_ARTIFACTS_BUCKET=mlflow-artifacts

# Host ports
MLFLOW_PORT=5000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DBGATE_PORT=5050        # DB UI (DbGate), published on 127.0.0.1 only; validation mode uses 15050

# Postgres server flags (D17). Lower them on a small host; validation mode uses these defaults too.
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_MAX_WAL_SIZE=4GB

# Project database role passwords: local default = the role name. Override per role, e.g.
# APP_USER_PASSWORD=...   DAB_AGENT_PASSWORD=...   (AWS: Secrets Manager, never here)

# What sibling projects set (the only couplings): the MLflow URI and their database URLs,
# which `make db-init` writes to .db-urls.env for copy-paste.
# MLFLOW_TRACKING_URI=http://localhost:5000
# DATABASE_URL=postgresql://<role>:<password>@localhost:5432/<database>
